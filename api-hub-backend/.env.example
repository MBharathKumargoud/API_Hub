# Copy this file to ".env" in the same folder as pom.xml.
# Replace placeholders with your own local values.

DB_URL=jdbc:mysql://localhost:3306/api_hub?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Generate a secure secret for local development.
JWT_SECRET=replace_with_a_secure_secret_of_at_least_32_characters
JWT_EXPIRATION_MINUTES=60

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Development: update
# Production: validate
DDL_AUTO=update

# Password reset email configuration
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=your_email@gmail.com